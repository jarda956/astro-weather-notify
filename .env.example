# Copy this file to .env and adjust values before starting the app.

# Port the web server listens on
PORT=3000

# Secret used to sign login sessions (JWT). Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Where the SQLite database file is stored
DATABASE_PATH=./data/astro-weather.sqlite

# Telegram bot token from @BotFather. Leave empty to disable Telegram notifications.
TELEGRAM_BOT_TOKEN=

# Cron expression for how often to check forecasts and send notifications (default: every hour).
# Every upcoming night is checked on every tick; a message is only sent when a night's
# clear-sky verdict actually changes, so a shorter interval doesn't cause more messages.
NOTIFY_CRON=0 * * * *
